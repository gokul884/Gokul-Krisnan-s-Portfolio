{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "order": { "type": "number" },
        "techStack": { "type": "array" }
      },
      "required": ["title", "description", "order"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Professional certification",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "provider": { "type": "string" },
        "issueDate": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "provider"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Professional work experience entry",
      "type": "object",
      "properties": {
        "year": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["year", "title", "company", "description", "order"]
    },
    "GuestMessage": {
      "title": "Guest Message",
      "description": "Message left by visitors in the guestbook",
      "type": "object",
      "properties": {
        "userName": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["userName", "message"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global portfolio configuration and profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "profileImageUrl": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "List of portfolio projects"
    },
    "/certificates/{certId}": {
      "schema": "Certificate",
      "description": "List of certifications"
    },
    "/experiences/{expId}": {
      "schema": "Experience",
      "description": "Work history timeline"
    },
    "/guestbook/{messageId}": {
      "schema": "GuestMessage",
      "description": "Visitor messages"
    },
    "/settings/global": {
      "schema": "SiteSettings",
      "description": "Central site configuration"
    }
  }
}
