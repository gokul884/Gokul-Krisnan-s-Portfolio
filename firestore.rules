rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'krishnan989756@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validations ---

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'order']) &&
             data.title is string && data.title.size() > 0 &&
             data.description is string && data.description.size() > 0 &&
             data.order is number;
    }

    function isValidCertificate(data) {
      return data.keys().hasAll(['title', 'provider']) &&
             data.title is string && data.title.size() > 0 &&
             data.provider is string && data.provider.size() > 0;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['year', 'title', 'company', 'description', 'order']) &&
             data.year is string &&
             data.title is string &&
             data.company is string &&
             data.order is number;
    }

    function isValidGuestMessage(data) {
      return data.keys().hasAll(['userName', 'message']) &&
             data.userName is string && data.userName.size() > 0 &&
             data.message is string && data.message.size() > 0;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    // certificates collection
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCertificate(incoming());
      allow delete: if isAdmin();
    }

    // experiences collection
    match /experiences/{expId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidExperience(incoming());
      allow delete: if isAdmin();
    }

    // settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // guestbook collection
    match /guestbook/{messageId} {
      // Admin can see all messages (list/get) and delete them
      allow get, list, delete: if isAdmin();
      // Anyone can leave a message
      allow create: if isValidGuestMessage(incoming());
      // No updates to messages allowed by anyone
      allow update: if false;
    }
  }
}
