rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'krishnan989756@gmail.com' && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // certificates collection
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // experiences collection
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // guestbook collection
    match /guestbook/{messageId} {
      // Admin can see all messages
      allow get, list, delete: if isAdmin();
      // Anyone can leave a message
      allow create: if 
        incoming().userName is string && incoming().userName.size() > 0 &&
        incoming().message is string && incoming().message.size() > 0;
      // No updates to messages allowed by anyone
      allow update: if false;
    }
  }
}
